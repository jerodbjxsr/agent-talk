#!/bin/sh
# Test stub standing in for the claude CLI. Records its argv for assertions,
# consumes stdin (the prompt), optionally dawdles (timeout tests), then emits
# a canned single-JSON-doc answer like `claude -p --output-format json`.
# The `mcp` subcommand (used by install.sh) is logged and succeeds.
if [ "$1" = "mcp" ]; then
  printf '%s\n' "$*" >> "$HOME/.claude-stub-mcp.log"
  exit 0
fi
if [ -n "$STUB_ARGV_FILE" ]; then
  printf '%s\n' "$@" > "$STUB_ARGV_FILE"
fi
if [ -n "$STUB_DEPTH_FILE" ]; then
  printf '%s' "${AGENT_TALK_DEPTH:-unset}" > "$STUB_DEPTH_FILE"
fi
cat > /dev/null
if [ -n "$STUB_SLEEP" ]; then
  # Grandchild that tries to outlive us: proves the relay kills the whole
  # process group on timeout, not just this script.
  ( sleep 2 && touch "$STUB_MARKER" ) &
  sleep "$STUB_SLEEP"
fi
if [ -n "$STUB_ERROR" ]; then
  printf '{"result":"stub failure text","is_error":true}'
else
  printf '{"result":"stub answer","is_error":false}'
fi
