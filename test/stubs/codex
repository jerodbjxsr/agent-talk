#!/bin/sh
# Test stub standing in for the codex CLI. Answers --version (the installer
# checks it) and otherwise emits a minimal NDJSON transcript like
# `codex exec --json`. Records argv/env for relay assertions.
if [ "$1" = "--version" ]; then
  echo "codex-cli 0.144.1"
  exit 0
fi
if [ -n "$STUB_ARGV_FILE" ]; then
  printf '%s\n' "$@" > "$STUB_ARGV_FILE"
fi
if [ -n "$STUB_ENV_FILE" ]; then
  env > "$STUB_ENV_FILE"
fi
cat > /dev/null
printf '{"type":"item.completed","item":{"id":"item_0","type":"agent_message","text":"stub codex answer"}}\n'
